DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=replace-me
JWT_SECRET=replace-me-with-a-different-secret
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://anonymoke:anonymoke@localhost:5432/anonymoke
REDIS_URL=redis://localhost:6379/0

# Firebase Cloud Messaging. Use a Firebase Admin service-account JSON object,
# not the Android google-services.json client configuration.
FIREBASE_PROJECT_ID=anonymoke-e038b
SAFETY_ALERT_PROVIDER=unconfigured
FIREBASE_SERVICE_ACCOUNT_JSON=

# Authentication decisions: Google/Apple social sign-in + Resend magic links.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@anonymoke.co.ke
MAGIC_LINK_TTL_MINUTES=10
MAGIC_LINK_RESEND_COOLDOWN_SECONDS=60
MAGIC_LINK_MAX_ATTEMPTS_PER_HOUR=5
MAGIC_LINK_BASE_URL=anonymoke://auth/magic-link?token=
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_ISSUER=https://accounts.google.com
GOOGLE_OIDC_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
APPLE_SERVICE_ID=
APPLE_BUNDLE_ID=
APPLE_OIDC_ISSUER=https://appleid.apple.com
APPLE_OIDC_JWKS_URL=https://appleid.apple.com/auth/keys
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Privacy and storage secrets. Never commit real values.
LOCATION_HMAC_SECRET=
FIELD_ENCRYPTION_KEY=
REQUIRE_VERIFICATION_PRE_DISCOVERY=false
REQUIRE_VERIFICATION_PRE_UNMASK=true
VERIFICATION_PROVIDER=smile_id
VERIFICATION_WEBHOOK_SECRET=
SMILE_ID_ENVIRONMENT=sandbox
SMILE_ID_PARTNER_ID=
SMILE_ID_API_KEY=
SMILE_ID_CALLBACK_URL=
SMILE_ID_PRIVACY_URL=
SMILE_ID_REDIRECT_URL=
SMILE_ID_LINK_HOSTS=links.usesmileid.com,links.smileidentity.com
# Set true only after Smile ID confirms the minimum-age-18 document/liveness policy.
SMILE_ID_ADULT_POLICY_CONFIRMED=false
SAFETY_RETENTION_DAYS=90
AUTO_SUSPEND_SCAM_REPORTS=true
AUTO_SUSPEND_REPORT_THRESHOLD=3
CHAT_MAX_MESSAGE_LENGTH=2000
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_PRIVATE=
R2_BUCKET_PUBLIC_DERIVED=
PAYMENT_PROVIDER=dummy
DARAJA_BASE_URL=https://sandbox.safaricom.co.ke
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_BASE_URL=
DARAJA_CALLBACK_TOKEN=
MEDIA_UPLOAD_URL_TTL_SECONDS=900
MEDIA_AVATAR_MAX_BYTES=10485760
MEDIA_AUDIO_MAX_BYTES=5242880
MEDIA_AUDIO_MAX_DURATION_MS=15500
MEDIA_REQUIRE_EXACTLY_ONE_FACE=true

